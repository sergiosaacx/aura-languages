 cry?\", \"words\": [{\"w\": \"You\", \"t\": 220.96}, {\"w\": \"try\", \"t\": 221.26}, {\"w\": \"to\", \"t\": 221.52}, {\"w\": \"cry\", \"t\": 222.14}, {\"w\": \"We\", \"t\": 222.36}]}, {\"t\": 222.36, \"end\": 224.34, \"text\": \"We try not to cry.\", \"words\": [{\"w\": \"cry\", \"t\": 222.14}, {\"w\": \"We\", \"t\": 222.36}, {\"w\": \"try\", \"t\": 222.66}, {\"w\": \"not\", \"t\": 223.02}, {\"w\": \"to\", \"t\": 223.52}, {\"w\": \"cry\", \"t\": 224.34}]}, {\"t\": 224.8, \"end\": 226.64, \"text\": \"You have one minute. Go!\", \"words\": [{\"w\": \"You\", \"t\": 224.8}, {\"w\": \"have\", \"t\": 224.98}, {\"w\": \"one\", \"t\": 225.2}, {\"w\": \"minute\", \"t\": 225.56}, {\"w\": \"Go\", \"t\": 226.3}]}, {\"t\": 229.02, \"end\": 229.74, \"text\": \"1979.\", \"words\": [{\"w\": \"1979\", \"t\": 229.02}]}, {\"t\": 230.2, \"end\": 230.66, \"text\": \"November.\", \"words\": [{\"w\": \"November\", \"t\": 230.2}]}, {\"t\": 231.68, \"end\": 233.12, \"text\": \"You were...\", \"words\": [{\"w\": \"You\", \"t\": 231.68}, {\"w\": \"were\", \"t\": 232.4}, {\"w\": \"I\", \"t\": 233.12}]}, {\"t\": 233.12, \"end\": 236.24, \"text\": \"I never got a chance\", \"words\": [{\"w\": \"I\", \"t\": 233.12}, {\"w\": \"never\", \"t\": 234.38}, {\"w\": \"got\", \"t\": 235.04}, {\"w\": \"a\", \"t\": 235.7}, {\"w\": \"chance\", \"t\": 235.92}, {\"w\": \"to\", \"t\": 236.24}, {\"w\": \"say\", \"t\": 236.54}]}, {\"t\": 236.24, \"end\": 237.9, \"text\": \"to say goodbye to Daniel!\", \"words\": [{\"w\": \"to\", \"t\": 236.24}, {\"w\": \"say\", \"t\": 236.54}, {\"w\": \"goodbye\", \"t\": 236.68}, {\"w\": \"to\", \"t\": 237.12}, {\"w\": \"Daniel\", \"t\": 237.9}]}, {\"t\": 240.14, \"end\": 241.44, \"text\": \"Now you're good!\", \"words\": [{\"w\": \"Now\", \"t\": 240.14}, {\"w\": \"you're\", \"t\": 240.5}, {\"w\": \"good\", \"t\": 240.86}, {\"w\": \"Okay\", \"t\": 241.5}]}, {\"t\": 241.5, \"end\": 243.64, \"text\": \"Okay. Amber, Wade, you're up!\", \"words\": [{\"w\": \"Okay\", \"t\": 241.5}, 
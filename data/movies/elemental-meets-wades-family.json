"fast\", \"t\": 19.82}, {\"w\": \"for\", \"t\": 20.28}, {\"w\": \"your\", \"t\": 20.5}, {\"w\": \"age\", \"t\": 20.64}, {\"w\": \"You\", \"t\": 21.16}]}, {\"t\": 21.16, \"end\": 23.12, \"text\": \"You have no idea.\", \"words\": [{\"w\": \"You\", \"t\": 21.16}, {\"w\": \"have\", \"t\": 21.36}, {\"w\": \"no\", \"t\": 21.64}, {\"w\": \"idea\", \"t\": 22.36}]}, {\"t\": 25.1, \"end\": 28.06, \"text\": \"Amber! Oh, I'm so excited to finally meet you.\", \"words\": [{\"w\": \"Amber\", \"t\": 25.1}, {\"w\": \"Oh\", \"t\": 25.84}, {\"w\": \"I'm\", \"t\": 26.28}, {\"w\": \"so\", \"t\": 26.44}, {\"w\": \"excited\", \"t\": 26.86}, {\"w\": \"to\", \"t\": 27.12}, {\"w\": \"finally\", \"t\": 27.38}, {\"w\": \"meet\", \"t\": 27.62}, {\"w\": \"you\", \"t\": 27.84}, {\"w\": \"Do\", \"t\": 28.06}]}, {\"t\": 28.06, \"end\": 32.06, \"text\": \"Do we hug or wave or don't want to put you out?\", \"words\": [{\"w\": \"you\", \"t\": 27.84}, {\"w\": \"Do\", \"t\": 28.06}, {\"w\": \"we\", \"t\": 28.56}, {\"w\": \"hug\", \"t\": 28.76}, {\"w\": \"or\", \"t\": 29.24}, {\"w\": \"wave\", \"t\": 29.76}, {\"w\": \"or\", \"t\": 30.26}, {\"w\": \"don't\", \"t\": 30.64}, {\"w\": \"want\", \"t\": 31.06}, {\"w\": \"to\", \"t\": 31.2}, {\"w\": \"put\", \"t\": 31.3}, {\"w\": \"you\", \"t\": 31.42}, {\"w\": \"out\", \"t\": 31.58}]}, {\"t\": 32.76, \"end\": 34.44, \"text\": \"Um, a hello is fine.\", \"words\": [{\"w\": \"Um\", \"t\": 32.76}, {\"w\": \"a\", \"t\": 33.64}, {\"w\": \"hello\", \"t\": 33.64}, {\"w\": \"is\", \"t\": 33.7}, {\"w\": \"fine\", \"t\": 34.06}]}, {\"t\": 34.98, \"end\": 35.22, \"text\": \"Hardly.\", \"words\": [{\"w\": \"Hardly\", \"t\": 34.98}]}, {\"t\": 35.78, \"end\": 38.02, \"text\": \"Wade hadn't stopped talking about you since the day you met.\", \"words\": [{\"w\": \"Wade\", \"t\": 35.78}, {\"w\": \"hadn't\", \"t\": 35.78}, {\"w\": \"stopped\", \"t\": 36.02}, {\"w\": \"talking\", \"t\": 36.38}, {\"w\": \"about\", \"t\": 36.66}, {\"w\": \"you\", \"t\": 36.94}, {\"w\": \"since\", \"t\": 37.14}, {\"w\": \"the\", \"t\": 37.26}, {\"w\": \"day\", \"t\": 37.5}, {\"w\": \"you\", \"t\": 37.56}, {\"w\": \"met\", \"t\": 37.98}, {\"w\": \"The\", \"t\": 38.12}]}, {\"t\": 38.12, \"end\": 39.42, \"text\": \"The boy is smitten.\", \"words\": [{\"w\": \"met\", \"t\": 37.98}, {\"w\": \"The\", \"t\": 38.12}, {\"w\": \"boy\", \"t\": 38.5}, {\"w\": \"is\", \"t\": 38.74}, {\"w\": \"smitten\", \"t\": 39.1}, {\"w\": \"Mom\", \"t\": 39.68}]}, {\"t\": 39.68, \"end\": 40.18, \"text\": \"Mom!\", \"words\": [{\"w\": \"Mom\", \"t\": 39.68}, {\"w\": \"Oh\", \"t\": 40.22}]}, {\"t\": 40.22, \"end\": 41.78, \"text\": \"Oh, come on. I'm your mother.\", \"words\": [{\"w\": \"Oh\", \"t\": 40.22}, {\"w\": \"come\", \"t\": 40.56}, {\"w\": \"on\", \"t\": 40.8}, {\"w\": \"I'm\", \"t\": 41.12}, {\"w\": \"your\", \"t\": 41.24}, {\"w\": \"mother\", \"t\": 41.48}]}, {\"t\": 42.08, \"end\": 43.76, \"text\": \"I know when something's lighting you up.\", \"words\": [{\"w\": \"I\", \"t\": 42.08}, {\"w\": \"know\", \"t\": 42.28}, {\"w\": \"when\", \"t\": 42.38}, {\"w\": \"something's\", \"t\": 42.56}, {\"w\": \"lighting\", \"t\": 43.04}, {\"w\": \"you\", \"t\": 43.24}, {\"w\": \"up\", \"t\": 43.52}, {\"w\": \"I\", \"t\": 44.0}]}, {\"t\": 44.0, \"end\": 46.68, \"text\": \"I just didn't know she'd be so smoky.\", \"words\": [{\"w\": \"I\", \"t\": 44.0}, {\"w\": \"just\", \"t\": 44.28}, {\"w\": \"didn't\", \"t\": 44.62}, {\"w\": \"know\", \"t\": 44.78}, {\"w\": \"she'd\", \"t\": 44.98}, {\"w\": \"be\", \"t\": 45.3}, {\"w\": \"so\", \"t\": 45.44}, {\"w\": \"smoky\", \"t\": 45.78}]}, {\"t\": 50.1, \"end\": 52.16, \"text\": \"Come this way. Meet the rest of the family.\", \"words\": [{\"w\": \"Come\", \"t\": 50.1}, {\"w\": \"this\", \"t\": 50.66}, {\"w\": \"way\", \"t\": 50.9}, {\"w\": \"Meet\", \"t\": 51.34}, {\"w\": \"the\", \"t\": 51.38}, {\"w\": \"rest\", \"t\": 51.66}, {\"w\": \"of\", \"t\": 51.66}, {\"w\": \"the\", \"t\": 51.82}, {\"w\": \"family\", \"t\": 52.16}]}, {\"t\": 64.74, \"end\": 67.32, \"text\": \"Oh, honey, you won't believe what your baby niece did today.\", \"words\": [{\"w\": \"Oh\", \"t\": 64.74}, {\"w\": \"honey\", \"t\": 65.26}, {\"w\": \"you\", \"t\": 65.56}, {\"w\": \"won't\", \"t\": 65.68}, {\"w\": \"believe\", \"t\": 65.84}, {\"w\": \"what\", \"t\": 66.1}, {\"w\": \"your\", \"t\": 66.24}, {\"w\": \"baby\", \"t\": 66.4}, {\"w\": \"niece\", \"t\": 66.54}, {\"w\": \"did\", \"t\": 66.76}, {\"w\": \"today\", \"t\": 66.96}]}, {\"t\": 68.34, \"end\": 69.38, \"text\": \"She smiled.\", \"words\": [{\"w\": \"She\", \"t\": 68.34}, {\"w\": \"smiled\", \"t\": 68.86}, {\"w\": \"No\", \"t\": 69.58}]}, {\"t\": 69.58, \"end\": 71.08, \"text\": \"No, she didn't.\", \"words\": [{\"w\": \"No\", \"t\": 69.58}, {\"w\": \"she\", \"t\": 69.92}, {\"w\": \"didn't\", \"t\": 70.3}]}, {\"t\": 76.4, \"end\": 78.4, \"text\": \"Hey, everyone. This is Amber.\", \"words\": [{\"w\": \"Hey\", \"t\": 76.4}, {\"w\": \"everyone\", \"t\": 76.92}, {\"w\": \"This\", \"t\": 77.54}, {\"w\": \"is\", \"t\": 77.98}, {\"w\": \"Amber\", \"t\": 78.28}]}, {\"t\": 78.9, \"end\": 79.42, \"text\": \"Hey.\", \"words\": [{\"w\": \"Hey\", \"t\": 78.9}, {\"w\": \"That's\", \"t\": 79.7}]}, {\"t\": 79.7, \"end\": 82.22, \"text\": \"That's my brother, Alan, and his wife, Eddie.\", \"words\": [{\"w\": \"That's\", \"t\": 79.7}, {\"w\": \"my\", \"t\": 80.14}, {\"w\": \"brother\", \"t\": 80.52}, {\"w\": \"Alan\", \"t\": 80.58}, {\"w\": \"and\", \"t\": 81.0}, {\"w\": \"his\", \"t\": 81.46}, {\"w\": \"wife\", \"t\": 81.86}, {\"w\": \"Eddie\", \"t\": 82.08}, {\"w\": \"Hi\", \"t\": 82.4}]}, {\"t\": 82.4, \"end\": 82.78, \"text\": \"Hi.\", \"words\": [{\"w\": \"Hi\", \"t\": 82.4}, {\"w\": \"And\", \"t\": 83.02}]}, {\"t\": 83.02, \"end\": 85.46, \"text\": \"And we got two kids that are swimming around here somewhere.\", \"words\": [{\"w\": \"And\", \"t\": 83.02}, {\"w\": \"we\", \"t\": 83.28}, {\"w\": \"got\", \"t\": 83.48}, {\"w\": \"two\", \"t\": 83.6}, {\"w\": \"kids\", \"t\": 84.06}, {\"w\": \"that\", \"t\": 84.18}, {\"w\": \"are\", \"t\": 84.32}, {\"w\": \"swimming\", \"t\": 84.5}, {\"w\": \"around\", \"t\": 84.66}, {\"w\": \"here\", \"t\": 84.88}, {\"w\": \"somewhere\", \"t\": 85.2}]}, {\"t\": 86.0, \"end\": 87.72, \"text\": \"Marco! Follow!\", \"words\": [{\"w\": \"Marco\", \"t\": 86.0}, {\"w\": \"Follow\", \"t\": 87.2}]}, {\"t\": 88.68, \"end\": 91.06, \"text\": \"Hi, Uncle Wade!\", \"words\": [{\"w\": \"Hi\", \"t\": 88.68}, {\"w\": \"Uncle\", \"t\": 90.58}, {\"w\": \"Wade\", \"t\": 90.88}, {\"w\": \"Do\", \"t\": 91.2}, {\"w\": \"you\", \"t\": 91.24}]}, {\"t\": 91.2, \"end\": 93.12, \"text\": \"Do you die if you fall in water?\", \"words\": [{\"w\": \"Do\", \"t\": 91.2}, {\"w\": \"you\", \"t\": 91.24}, {\"w\": \"die\", \"t\": 91.52}, {\"w\": \"if\", \"t\": 91.88}, {\"w\": \"you\", \"t\": 92.06}, {\"w\": \"fall\", \"t\": 92.44}, {\"w\": \"in\", \"t\": 92.44}, {\"w\": \"water\", \"t\": 92.72}]}, {\"t\": 93.9, \"end\": 94.46, \"text\": \"Marco!\", \"words\": [{\"w\": \"Marco\", \"t\": 93.9}]}, {\"t\": 95.96, \"end\": 97.12, \"text\": \"Don't hate us.\", \"words\": [{\"w\": \"Don't\", \"t\": 95.96}, {\"w\": \"hate\", \"t\": 96.52}, {\"w\": \"us\", \"t\": 96.8}]}, {\"t\": 97.52, \"end\": 100.46, \"text\": \"Anyway, that's my little sub-lake and her girlfriend, Ghibli.\", \"words\": [{\"w\": \"Anyway\", \"t\": 97.52}, {\"w\": \"that's\", \"t\": 98.08}, {\"w\": \"my\", \"t\": 98.36}, {\"w\": \"little\", \"t\": 98.5}, {\"w\": \"sub\", \"t\": 98.76}, {\"w\": \"lake\", \"t\": 98.96}, {\"w\": \"and\", \"t\": 99.26}, {\"w\": \"her\", \"t\": 99.54}, {\"w\": \"girlfriend\", \"t\": 99.82}, {\"w\": \"Ghibli\", \"t\": 100.16}]}, {\"t\": 100.94, \"end\": 101.04, \"text\": \"What's up?\", \"words\": [{\"w\": \"What's\", \"t\": 100.94}, {\"w\": \"up\", \"t\": 100.94}, {\"w\": \"They're\", \"t\": 101.18}]}, {\"t\": 101.18, \"end\": 103.62, \"text\": \"They're students at Element City School for the Arts.\", \"words\": [{\"w\": \"What's\", \"t\": 100.94}, {\"w\": \"up\", 
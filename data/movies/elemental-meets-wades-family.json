"call\", \"t\": 113.9}, {\"w\": \"them\", \"t\": 113.9}, {\"w\": \"colors\", \"t\": 114.52}, {\"w\": \"Oh\", \"t\": 115.26}]}, {\"t\": 115.26, \"end\": 117.7, \"text\": \"Oh, don't listen to him. He's a wonderful painter.\", \"words\": [{\"w\": \"Oh\", \"t\": 115.26}, {\"w\": \"don't\", \"t\": 115.58}, {\"w\": \"listen\", \"t\": 115.76}, {\"w\": \"to\", \"t\": 115.96}, {\"w\": \"him\", \"t\": 116.2}, {\"w\": \"He's\", \"t\": 116.74}, {\"w\": \"a\", \"t\": 116.92}, {\"w\": \"wonderful\", \"t\": 117.36}, {\"w\": \"painter\", \"t\": 117.52}, {\"w\": \"One\", \"t\": 117.7}]}, {\"t\": 117.7, \"end\": 121.38, \"text\": \"One of his paintings just got in the Element City Museum's permanent collection.\", \"words\": [{\"w\": \"painter\", \"t\": 117.52}, {\"w\": \"One\", \"t\": 117.7}, {\"w\": \"of\", \"t\": 118.44}, {\"w\": \"his\", \"t\": 118.56}, {\"w\": \"paintings\", \"t\": 118.72}, {\"w\": \"just\", \"t\": 118.96}, {\"w\": \"got\", \"t\": 119.22}, {\"w\": \"in\", \"t\": 119.38}, {\"w\": \"the\", \"t\": 119.52}, {\"w\": \"Element\", \"t\": 119.66}, {\"w\": \"City\", \"t\": 119.82}, {\"w\": \"Museum's\", \"t\": 120.06}, {\"w\": \"permanent\", \"t\": 120.54}, {\"w\": \"collection\", \"t\": 120.88}]}, {\"t\": 121.7, \"end\": 123.12, \"text\": \"Wow, that is so cool.\", \"words\": [{\"w\": \"Wow\", \"t\": 121.7}, {\"w\": \"that\", \"t\": 122.02}, {\"w\": \"is\", \"t\": 122.5}, {\"w\": \"so\", \"t\": 122.5}, {\"w\": \"cool\", \"t\": 122.82}, {\"w\": \"My\", \"t\": 123.24}]}, {\"t\": 123.24, \"end\": 125.6, \"text\": \"My only talent is clean up on aisle four.\", \"words\": [{\"w\": \"My\", \"t\": 123.24}, {\"w\": \"only\", \"t\": 123.62}, {\"w\": \"talent\", \"t\": 123.88}, {\"w\": \"is\", \"t\": 124.14}, {\"w\": \"clean\", \"t\": 124.32}, {\"w\": \"up\", \"t\": 124.6}, {\"w\": \"on\", \"t\": 124.74}, {\"w\": \"aisle\", \"t\": 125.1}, {\"w\": \"four\", \"t\": 125.1}, {\"w\": \"Talk\", \"t\": 125.8}]}, {\"t\": 125.8, \"end\": 126.9, \"text\": \"Talk about being modest.\", \"words\": [{\"w\": \"Talk\", \"t\": 125.8}, {\"w\": \"about\", \"t\": 126.02}, {\"w\": \"being\", \"t\": 126.22}, {\"w\": \"modest\", \"t\": 126.9}]}, {\"t\": 127.24, \"end\": 129.16, \"text\": \"Amber's got an incredible creative flame.\", \"words\": [{\"w\": \"Amber's\", \"t\": 127.24}, {\"w\": \"got\", \"t\": 127.34}, {\"w\": \"an\", \"t\": 127.48}, {\"w\": \"incredible\", \"t\": 127.74}, {\"w\": \"creative\", \"t\": 128.28}, {\"w\": \"flame\", \"t\": 128.78}, {\"w\": \"I've\", \"t\": 129.22}]}, {\"t\": 129.22, \"end\": 130.66, \"text\": \"I've never seen anything like it.\", \"words\": [{\"w\": \"I've\", \"t\": 129.22}, {\"w\": \"never\", \"t\": 129.56}, {\"w\": \"seen\", \"t\": 129.66}, {\"w\": \"anything\", \"t\": 129.84}, {\"w\": \"like\", \"t\": 130.16}, {\"w\": \"it\", \"t\": 130.52}, {\"w\": \"I\", \"t\": 130.7}]}, {\"t\": 130.7, \"end\": 135.18, \"text\": \"I just have to say that you speak so well and clear.\", \"words\": [{\"w\": \"it\", \"t\": 130.52}, {\"w\": \"I\", \"t\": 130.7}, {\"w\": \"just\", \"t\": 131.12}, {\"w\": \"have\", \"t\": 131.52}, {\"w\": \"to\", \"t\": 131.78}, {\"w\": \"say\", \"t\": 132.0}, {\"w\": \"that\", \"t\": 132.22}, {\"w\": \"you\", \"t\": 132.48}, {\"w\": \"speak\", \"t\": 132.86}, {\"w\": \"so\", \"t\": 133.2}, {\"w\": \"well\", \"t\": 133.9}, {\"w\": \"and\", \"t\": 134.38}, {\"w\": \"clear\", \"t\": 134.78}]}, {\"t\": 136.82, \"end\": 140.58, \"text\": \"Yeah, it's amazing what talking in the same language your entire life can do.\", \"words\": [{\"w\": \"Yeah\", \"t\": 136.82}, {\"w\": \"it's\", \"t\": 137.38}, {\"w\": \"amazing\", \"t\": 137.94}, {\"w\": \"what\", \"t\": 138.2}, {\"w\": \"talking\", \"t\": 138.5}, {\"w\": \"in\", \"t\": 138.7}, {\"w\": \"the\", \"t\": 138.86}, {\"w\": \"same\", \"t\": 138.96}, {\"w\": \"language\", \"t\": 139.24}, {\"w\": \"your\", \"t\": 139.42}, {\"w\": \"entire\", \"t\": 139.62}, {\"w\": \"life\", \"t\": 139.9}, {\"w\": \"can\", \"t\": 140.16}, {\"w\": \"do\", \"t\": 140.34}]}, {\"t\": 141.3, \"end\": 142.24, \"text\": \"Hey, Amber.\", \"words\": [{\"w\": \"Hey\", \"t\": 141.3}, {\"w\": \"Amber\", \"t\": 141.9}, {\"w\": \"Did\", \"t\": 142.44}]}, {\"t\": 142.44, \"end\": 146.38, \"text\": \"Did Wadey here ever tell you that he's deadly afraid of sponges?\", \"words\": [{\"w\": \"Did\", \"t\": 142.44}, {\"w\": \"Wadey\", \"t\": 142.78}, {\"w\": \"here\", \"t\": 143.24}, {\"w\": \"ever\", \"t\": 143.58}, {\"w\": \"tell\", \"t\": 143.94}, {\"w\": \"you\", \"t\": 144.18}, {\"w\": \"that\", \"t\": 144.32}, {\"w\": \"he's\", \"t\": 144.54}, {\"w\": \"deadly\", \"t\": 144.8}, {\"w\": \"afraid\", \"t\": 145.24}, {\"w\": \"of\", \"t\": 145.6}, {\"w\": \"sponges\", \"t\": 145.98}, {\"w\": \"No\", \"t\": 146.46}]}, {\"t\": 146.46, \"end\": 146.98, \"text\": \"No.\", \"words\": [{\"w\": \"No\", \"t\": 146.46}, {\"w\": \"I\", \"t\": 146.98}]}, {\"t\": 146.98, \"end\": 148.8, \"text\": \"I was traumatized.\", \"words\": [{\"w\": \"I\", \"t\": 146.98}, {\"w\": \"was\", \"t\": 147.56}, {\"w\": \"traumatized\", \"t\": 147.82}]}, {\"t\": 157.9, \"end\": 160.6, \"text\": \"I still can't use a sponge around him.\", \"words\": [{\"w\": \"I\", \"t\": 157.9}, {\"w\": \"still\", \"t\": 158.56}, {\"w\": \"can't\", \"t\": 159.22}, {\"w\": \"use\", \"t\": 159.52}, {\"w\": \"a\", \"t\": 159.7}, {\"w\": \"sponge\", \"t\": 160.06}, {\"w\": \"around\", \"t\": 160.1}, {\"w\": \"him\", \"t\": 160.44}, {\"w\": \"I\", \"t\": 160.66}, {\"w\": \"was\", \"t\": 160.84}]}, {\"t\": 160.66, \"end\": 162.58, \"text\": \"I was stuck in there for hours.\", \"words\": [{\"w\": \"him\", \"t\": 160.44}, {\"w\": \"I\", \"t\": 160.66}, {\"w\": \"was\", \"t\": 160.84}, {\"w\": \"stuck\", \"t\": 161.18}, {\"w\": \"in\", \"t\": 161.4}, {\"w\": \"there\", \"t\": 161.6}, {\"w\": \"for\", \"t\": 161.74}, {\"w\": \"hours\", \"t\": 162.58}]}, {\"t\": 164.38, \"end\": 165.78, \"text\": \"Alan, that was new.\", \"words\": [{\"w\": \"Alan\", \"t\": 164.17}, {\"w\": \"that\", \"t\": 164.5}, {\"w\": \"was\", \"t\": 165.1}, {\"w\": \"new\", \"t\": 165.28}, {\"w\": \"My\", \"t\": 165.86}]}, {\"t\": 165.86, \"end\": 167.96, \"text\": \"My bad. I'm all whirlpool tonight.\", \"words\": [{\"w\": \"My\", \"t\": 165.86}, {\"w\": \"bad\", \"t\": 166.18}, {\"w\": \"I'm\", \"t\": 166.68}, {\"w\": \"all\", \"t\": 166.96}, {\"w\": \"whirlpool\", \"t\": 167.16}, {\"w\": \"tonight\", \"t\": 167.54}, {\"w\": \"I\", \"t\": 168.2}]}, {\"t\": 168.2, \"end\": 169.62, \"text\": \"I can fix it.\", \"words\": [{\"w\": \"I\", \"t\": 168.2}, {\"w\": \"can\", \"t\": 168.84}, {\"w\": \"fix\", \"t\": 169.04}, {\"w\": \"it\", \"t\": 169.22}]}, {\"t\": 189.2, \"end\": 189.84, \"text\": \"I'm so sorry.\", \"words\": [{\"w\": \"I'm\", \"t\": 189.2}, {\"w\": \"so\", \"t\": 189.84}, {\"w\": \"sorry\", \"t\": 189.84}, {\"w\": \"Oh\", \"t\": 189.86}]}, {\"t\": 189.86, \"end\": 191.14, \"text\": \"Oh, um...\", \"words\": [{\"w\": \"so\", \"t\": 189.84}, {\"w\": \"sorry\", \"t\": 189.84}, {\"w\": \"Oh\", \"t\": 189.86}, {\"w\": \"um\", \"t\": 190.5}]}, {\"t\": 191.8, \"end\": 192.44, \"text\": \"Sorry.\", \"words\": [{\"w\": \"Sorry\", \"t\": 191.8}]}, {\"t\": 193.54, \"end\": 195.44, \"text\": \"That was incredible!\", \"words\": [{\"w\": \"That\", \"t\": 193.54}, {\"w\": \"was\", \"t\": 194.18}, {\"w\": \"incredible\", \"t\": 194.7}]}, {\"t\": 197.38, \"end\": 198.26, \"text\": \"It's just melted glass.\", \"words\": [{\"w\": \"It's\", \"t\": 197.18}, {\"w\": \"just\", \"t\": 197.5}, {\"w\": \"melted\", \"t\": 197.7}, {\"w\": \"glass\", \"t\": 197.86}]}, {\"t\": 198.64, \"end\": 199.56, \"text\": \"Just melted glass?\", \"words\": [{\"w\": \"Just\", \"t\": 198.64}, {\"w\": \"melted\", \"t\": 198.92}, {\"w\": \"glass\", \"t\": 199.12}]}, {\"t\": 199.98, \"end\": 203.2, \"text\": \"Every building in the new city is built from just melted glass.\", \"words\": [{\"w\": \"Every\", \"t\": 199.98}, {\"w\": \"building\", \"t\": 200.24}, {\"w\": \"in\", \"t\": 200.52}, {\"w\": \"the\", \"t\": 200.64}, {\"w\": \